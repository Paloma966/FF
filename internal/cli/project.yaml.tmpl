name: "{{.Name}}"
created_at: "{{.CreatedAt}}"

story:
  title: "{{.StoryTitle}}"
  genre: "{{.Genre}}"
  premise: "{{.Premise}}"
  pov: "{{.POV}}"
  tense: "{{.Tense}}"
  language: "{{.Language}}"

protagonist:
  name: "{{.ProtagonistName}}"
  initial_beliefs:
{{- range .InitialBeliefs }}
    - "{{.}}"
{{- end }}
  initial_goals:
{{- range .InitialGoals }}
    - "{{.}}"
{{- end }}
  initial_fears:
{{- range .InitialFears }}
    - "{{.}}"
{{- end }}
  initial_values:
{{- range .InitialValues }}
    - "{{.}}"
{{- end }}

llm:
  provider: "{{.LLMProvider}}"
  model: "{{.LLMModel}}"
  api_key: "{{.LLMAPIKey}}"
{{- if .LLMBaseURL }}
  base_url: "{{.LLMBaseURL}}"
{{- end }}
  temperature: {{.LLMTemperature}}
  max_tokens: {{.LLMMaxTokens}}
